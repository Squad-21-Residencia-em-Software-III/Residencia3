# Copie este arquivo para `.env` na raiz do projeto e preencha com as suas credenciais locais.
# O `.env` real NÃO vai para o GitHub (está no .gitignore).

# Conexão com o PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=frotas_svo

# TLS/SSL: ativado automaticamente para hosts remotos com validação de certificado (rejectUnauthorized: true).
# Defina POSTGRES_SSL=true para forçar TLS localmente ou POSTGRES_SSL_CA se usar CA própria.
POSTGRES_SSL=false

# Credenciais da aplicação em execução (conta de mínimo privilégio: apenas SELECT, INSERT, UPDATE, DELETE)
POSTGRES_APP_USER=frotas_app
POSTGRES_APP_PASSWORD=troque_pela_senha_do_usuario_da_aplicacao

# Credenciais exclusivas para execução de migrations e seeds (DDL / proprietário do schema)
POSTGRES_MIGRATION_USER=postgres
POSTGRES_MIGRATION_PASSWORD=troque_pela_senha_do_usuario_de_migrations

# Variáveis padrão do container PostgreSQL local (docker-compose) e fallback
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_pela_senha_do_usuario_de_migrations

# Autenticação (JWT). Gere um segredo forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mínimo de 32 caracteres; valores de exemplo são recusados na inicialização.
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
# Validade do access token (até 8h) e do refresh token, que é o fim absoluto da sessão (até 24h).
# Formato <número><s|m|h|d>. Política em docs/seguranca-sessoes.md.
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=12h

# Sessão no navegador (docs/seguranca-sessoes.md)
# Origens do frontend autorizadas a chamar a API com credenciais, separadas por vírgula. Nunca use "*".
# Padrão: http://localhost:5173 em desenvolvimento; vazio em produção (frontend na mesma origem via proxy /api).
CORS_ORIGIN=http://localhost:5173
# Proxies reversos confiáveis à frente da API: número de saltos (ex.: 2) ou lista de IPs/CIDRs.
# Define o IP real do cliente usado no limite de tentativas. 0 = nenhum (só fora de produção).
# Obrigatório em produção; "true" e faixas /0 são recusados. Como calibrar: docs/seguranca-http.md.
TRUST_PROXY=0
# Cookie do refresh token com atributo Secure (HTTPS). Sempre true em produção; false só no desenvolvimento local.
COOKIE_SECURE=false

# Política de Backup e Recuperação do PostgreSQL
# Chave de criptografia em repouso (AES-256-GCM) dos arquivos de backup gerados localmente
BACKUP_ENCRYPTION_KEY=troque_por_uma_chave_de_criptografia_de_backup_forte
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backups

# Dimensionamento do Pool de Conexões do PostgreSQL e Timeouts (ms)
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
POSTGRES_POOL_ACQUIRE_TIMEOUT_MS=10000
POSTGRES_POOL_CREATE_TIMEOUT_MS=10000
POSTGRES_POOL_DESTROY_TIMEOUT_MS=5000
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000

# Tempos máximos no PostgreSQL (ms): consulta e transação ociosa. Desativados em migrations.
POSTGRES_STATEMENT_TIMEOUT_MS=10000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=15000

# Limites de requisição por IP e tempo máximo por requisição (docs/limites-e-timeouts.md).
# RATE_LIMIT=off desliga os limites gerais (proibido em produção).
RATE_LIMIT=on
RATE_LIMIT_LEITURA_POR_MIN=300
RATE_LIMIT_ESCRITA_POR_MIN=60
RATE_LIMIT_PESADAS_POR_MIN=30
MAX_REQUISICOES_SIMULTANEAS=50
REQUEST_TIMEOUT_MS=15000

# Fotos do odômetro (docs/evidencias-odometro.md)
# Onde guardar os arquivos: desativado (padrão; as rotas de foto respondem 503) ou local (pasta do servidor).
# Em produção, local exige EVIDENCIAS_STORAGE_DIR absoluto num disco persistente.
EVIDENCIAS_STORAGE=desativado
# Pasta do armazenamento local. Padrão: src/backend/storage/evidencias (ignorada pelo git).
EVIDENCIAS_STORAGE_DIR=
# true: iniciar e finalizar viagem exigem a foto (EVIDENCIA_OBRIGATORIA). Ligar junto com o front.
FOTOS_ODOMETRO_OBRIGATORIAS=false
