# Copie este arquivo para `.env` na raiz do projeto e preencha com as suas credenciais locais.
# O `.env` real NÃO vai para o GitHub (está no .gitignore).

# Conexão com o PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=frotas_svo

# TLS/SSL: ativado automaticamente para hosts remotos com validação de certificado (rejectUnauthorized: true).
# Defina POSTGRES_SSL=true para forçar TLS localmente ou POSTGRES_SSL_CA se usar CA própria.
POSTGRES_SSL=false

# Credenciais da aplicação em execução (conta de mínimo privilégio: apenas SELECT, INSERT, UPDATE, DELETE)
POSTGRES_APP_USER=frotas_app
POSTGRES_APP_PASSWORD=troque_pela_senha_do_usuario_da_aplicacao

# Credenciais exclusivas para execução de migrations e seeds (DDL / proprietário do schema)
POSTGRES_MIGRATION_USER=postgres
POSTGRES_MIGRATION_PASSWORD=troque_pela_senha_do_usuario_de_migrations

# Variáveis padrão do container PostgreSQL local (docker-compose) e fallback
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_pela_senha_do_usuario_de_migrations

# Autenticação (JWT). Gere um segredo forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mínimo de 32 caracteres; valores de exemplo são recusados na inicialização.
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
# Validade do access token (até 8h) e do refresh token, que é o fim absoluto da sessão (até 24h).
# Formato <número><s|m|h|d>. Política em docs/seguranca-sessoes.md.
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=12h

# Sessão no navegador (docs/seguranca-sessoes.md)
# Origens do frontend autorizadas a chamar a API com credenciais, separadas por vírgula. Nunca use "*".
# Padrão: http://localhost:5173 em desenvolvimento; vazio em produção (frontend na mesma origem via proxy /api).
CORS_ORIGIN=http://localhost:5173
# Proxies reversos confiáveis à frente da API no caminho direto: número de saltos (ex.: 1) ou lista de IPs/CIDRs.
# Define o IP real do cliente usado no limite de tentativas. 0 = nenhum (só fora de produção).
# Obrigatório em produção (no Render: 1); "true" e faixas /0 são recusados. Decisão: docs/seguranca-http.md.
TRUST_PROXY=0
# Segredo que a Vercel envia em X-Proxy-Secret no rewrite /api (mesmo valor nas duas plataformas).
# Com ele, a API valida o endereco informado pela borda da Vercel. Opcional; mínimo de 32 caracteres.
# PROXY_SECRET=
# Liga GET /api/diagnostico/ip (cabeçalho X-Diagnostico-Token) para validar a cadeia de proxies.
# Temporário: defina só durante a validação e remova depois. Mínimo de 32 caracteres.
# DIAGNOSTICO_PROXY_TOKEN=
# Cookie do refresh token com atributo Secure (HTTPS). Sempre true em produção; false só no desenvolvimento local.
COOKIE_SECURE=false

# Política de Backup e Recuperação do PostgreSQL
# Chave de criptografia em repouso (AES-256-GCM) dos arquivos de backup gerados localmente
BACKUP_ENCRYPTION_KEY=troque_por_uma_chave_de_criptografia_de_backup_forte
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backups

# Dimensionamento do Pool de Conexões do PostgreSQL e Timeouts (ms)
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
POSTGRES_POOL_ACQUIRE_TIMEOUT_MS=10000
POSTGRES_POOL_CREATE_TIMEOUT_MS=10000
POSTGRES_POOL_DESTROY_TIMEOUT_MS=5000
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000

# Tempos máximos no PostgreSQL (ms): consulta e transação ociosa. Desativados em migrations.
POSTGRES_STATEMENT_TIMEOUT_MS=10000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=15000

# Limites de requisição por IP e tempo máximo por requisição (docs/limites-e-timeouts.md).
# RATE_LIMIT=off desliga os limites gerais (proibido em produção).
RATE_LIMIT=on
RATE_LIMIT_LEITURA_POR_MIN=300
RATE_LIMIT_ESCRITA_POR_MIN=60
RATE_LIMIT_PESADAS_POR_MIN=30
MAX_REQUISICOES_SIMULTANEAS=50
REQUEST_TIMEOUT_MS=15000

# Fotos do odômetro (docs/evidencias-odometro.md)
# Onde guardar as fotos: desativado (padrão), local ou postgres (no PostgreSQL da API).
# Em produção, local exige EVIDENCIAS_STORAGE_DIR absoluto num disco persistente.
EVIDENCIAS_STORAGE=desativado
# Pasta do armazenamento local. Padrão: src/backend/storage/evidencias (ignorada pelo git).
EVIDENCIAS_STORAGE_DIR=
# true: iniciar e finalizar viagem exigem a foto (EVIDENCIA_OBRIGATORIA). Ligar junto com o front.
FOTOS_ODOMETRO_OBRIGATORIAS=false
EXCECOES_ODOMETRO_ATIVAS=false

# true: as operações publicam avisos (SCRUM-230). Exige as migrations das SCRUM-225 e 228.
NOTIFICACOES_ATIVAS=false

# true: libera cadastro e edição de CNH de motoristas (SCRUM-308). Só ative após a confirmação
# institucional da matriz de acesso (docs/scrum-308-cadastro-cnh.md). Exige a migration da SCRUM-308.
MOTORISTAS_ESCRITA_ATIVA=false

# Teto para os bytes das fotos salvas no PostgreSQL, de 1 a 512 MiB.
EVIDENCIAS_POSTGRES_LIMITE_MIB=128

# Alertas no aparelho / Web Push (SCRUM-237, docs/scrum-237-envio-push.md). Só no backend: o front recebe
# apenas a pública por GET /api/notificacoes/vapid-public-key. Vazias, o push fica desligado e os avisos
# continuam dentro do sistema. Gere o par com: npx web-push generate-vapid-keys
# A privada é segredo: nunca no front, no repositório nem em log.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável, exigido pelos serviços de push: mailto:... ou https://...
VAPID_SUBJECT=
# Opcional. Hosts de serviços de push aceitos nas assinaturas (padrão: FCM, Mozilla, Windows e Apple).
PUSH_HOSTS_PERMITIDOS=

# Recursos operacionais, todos desativados por padrão. Veja docs/configuracao-recursos-operacionais.md.
MAPAS_INTERNOS_ATIVOS=false
MULTIPLAS_PARADAS_ATIVAS=false
MAPAS_SVO_ATIVOS=false
PORTAL_SVO_ATIVO=false
ACOMPANHAMENTO_EXTERNO_SVO_ATIVO=false
# Segredo dedicado para digests e envelopes das credenciais externas SVO (SCRUM-266).
# Desacoplado de JWT_SECRET; obrigatorio em producao quando o portal/acompanhamento estiver ativo.
CREDENCIAL_EXTERNA_SVO_SECRET=
CREDENCIAL_EXTERNA_SVO_KEY_VERSION=1
# Opcional para rotacao sem invalidar credenciais vigentes: versao:segredo,versao:segredo
CREDENCIAL_EXTERNA_SVO_PREVIOUS_SECRETS=
# Versões do aviso de privacidade do portal SVO aceitas na criação (separadas por vírgula).
# Lista oficial definida pela instituição; vazio = só valida o formato (SCRUM-264).
AVISO_PRIVACIDADE_SVO_VERSOES=
GPS_OBRIGATORIO_ATIVO=false
EMERGENCIA_GPS_ATIVA=false
EMERGENCIA_GPS_AUTORIZADA=false
CAPTURA_PERIODICA_GPS_ATIVA=false
CONFIRMACAO_AUTOMATICA_PARADAS_ATIVA=false
PARAMETROS_CONFIRMACAO_PARADAS_HOMOLOGADOS=false
RETENCAO_GPS_CHECKPOINTS_ATIVA=false
RETENCAO_GPS_CHECKPOINTS_INVENTARIO_VALIDADO=false
RETENCAO_GPS_CHECKPOINTS_SIMULACAO_VALIDADA=false
RETENCAO_GPS_CHECKPOINTS_AUTORIZADA=false
RETENCAO_GPS_INTERMEDIARIOS_ATIVA=false
RETENCAO_GPS_INTERMEDIARIOS_INVENTARIO_VALIDADO=false
RETENCAO_GPS_INTERMEDIARIOS_SIMULACAO_VALIDADA=false
RETENCAO_GPS_INTERMEDIARIOS_AUTORIZADA=false
RETENCAO_SOLICITACOES_EXTERNAS_SVO_ATIVA=false
RETENCAO_SOLICITACOES_EXTERNAS_SVO_INVENTARIO_VALIDADO=false
RETENCAO_SOLICITACOES_EXTERNAS_SVO_SIMULACAO_VALIDADA=false
RETENCAO_SOLICITACOES_EXTERNAS_SVO_AUTORIZADA=false

# Proxy de mapas (SCRUM-275). Cache LRU: 500–1000 entradas, 24h e até 8 MiB estimados.
MAPAS_CACHE_ENTRADAS=750
# Vazio calcula o padrão (até 10500 ms), sempre com margem de 500 ms do timeout global.
MAPAS_ORCAMENTO_MS=
