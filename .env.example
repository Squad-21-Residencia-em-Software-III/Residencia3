# Copie este arquivo para `.env` na raiz do projeto e preencha com as suas credenciais locais.
# O `.env` real NÃO vai para o GitHub (está no .gitignore).

# Conexão com o PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=frotas_svo

# TLS/SSL: ativado automaticamente para hosts remotos com validação de certificado (rejectUnauthorized: true).
# Defina POSTGRES_SSL=true para forçar TLS localmente ou POSTGRES_SSL_CA se usar CA própria.
POSTGRES_SSL=false

# Credenciais da aplicação em execução (conta de mínimo privilégio: apenas SELECT, INSERT, UPDATE, DELETE)
POSTGRES_APP_USER=frotas_app
POSTGRES_APP_PASSWORD=troque_pela_senha_do_usuario_da_aplicacao

# Credenciais exclusivas para execução de migrations e seeds (DDL / proprietário do schema)
POSTGRES_MIGRATION_USER=postgres
POSTGRES_MIGRATION_PASSWORD=troque_pela_senha_do_usuario_de_migrations

# Variáveis padrão do container PostgreSQL local (docker-compose) e fallback
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_pela_senha_do_usuario_de_migrations

# Autenticação (JWT). Gere um segredo forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=8h

# Política de Backup e Recuperação do PostgreSQL
# Chave de criptografia em repouso (AES-256-GCM) dos arquivos de backup gerados localmente
BACKUP_ENCRYPTION_KEY=troque_por_uma_chave_de_criptografia_de_backup_forte
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backups

# Dimensionamento do Pool de Conexões do PostgreSQL e Timeouts (ms)
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
POSTGRES_POOL_ACQUIRE_TIMEOUT_MS=10000
POSTGRES_POOL_CREATE_TIMEOUT_MS=10000
POSTGRES_POOL_DESTROY_TIMEOUT_MS=5000
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000