# Copie este arquivo para `.env` na raiz do projeto e preencha com as suas credenciais locais.
# O `.env` real NÃO vai para o GitHub (está no .gitignore).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=a_sua_senha_aqui
POSTGRES_DB=frotas_svo

# Autenticação (JWT). Gere um segredo forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mínimo de 32 caracteres; valores de exemplo são recusados na inicialização.
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
# Validade do access token (até 8h) e do refresh token, que é o fim absoluto da sessão (até 24h).
# Formato <número><s|m|h|d>. Política em docs/seguranca-sessoes.md.
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=12h
