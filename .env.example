# Copie este arquivo para `.env` na raiz do projeto e preencha com as suas credenciais locais.
# O `.env` real NÃO vai para o GitHub (está no .gitignore).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=a_sua_senha_aqui
POSTGRES_DB=frotas_svo

# Autenticação (JWT). Gere um segredo forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=8h
