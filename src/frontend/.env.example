# Opcional. Em desenvolvimento o proxy do Vite já resolve /api -> http://localhost:3000.
# Em produção, aponte para a URL pública da API:
# VITE_API_URL=https://api.seudominio.com.br/api

# Ativar somente depois da homologação da API e das migrations do ambiente.
VITE_WEB_PUSH_ATIVO=false
VITE_FOTOS_ODOMETRO_ATIVAS=false
VITE_AGENDA_SVO_ATIVA=false
VITE_NOTIFICACOES_IN_APP_ATIVAS=false

# Visibilidade dos recursos operacionais. Veja docs/configuracao-recursos-operacionais.md.
VITE_MAPAS_INTERNOS_ATIVOS=false
VITE_MULTIPLAS_PARADAS_ATIVAS=false
VITE_MAPAS_SVO_ATIVOS=false
VITE_PORTAL_SVO_ATIVO=false
VITE_ACOMPANHAMENTO_EXTERNO_SVO_ATIVO=false
VITE_GPS_OBRIGATORIO_ATIVO=false
VITE_EMERGENCIA_GPS_ATIVA=false
VITE_CAPTURA_PERIODICA_GPS_ATIVA=false
VITE_CONFIRMACAO_AUTOMATICA_PARADAS_ATIVA=false

# Opcional. Estilo cartográfico gratuito do OpenFreeMap (padrão: Liberty).
# Aceita somente origens em https://tiles.openfreemap.org/styles/*.
# VITE_MAPA_ESTILO_URL=https://tiles.openfreemap.org/styles/liberty

# SCRUM-308: botões de cadastro e edição de CNH. Ligue junto com MOTORISTAS_ESCRITA_ATIVA no backend.
VITE_MOTORISTAS_ESCRITA_ATIVA=false
